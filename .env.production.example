# Backend-only production environment.
# Copy to crm-backend/.env on the VM.
# Never commit the real file.

NODE_ENV=production
PORT=3000
DB_ADAPTER=mysql

# Public API / CORS
API_DOMAIN=api.example.com
APP_URL=https://api.example.com
ALLOWED_ORIGINS=https://crm.example.com

# AWS Cognito authentication
# The frontend authenticates users with Cognito User Pools.
# The backend verifies Cognito JWTs and maps the Cognito subject to the
# application's users/org_members tables in MySQL.
AUTH_PROVIDER=cognito
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxx
COGNITO_CLIENT_ID=xxxxx
# Optional Cognito Hosted UI domain if the frontend uses OAuth/Hosted UI.
# COGNITO_DOMAIN=chiefvoice-production.auth.ap-south-1.amazoncognito.com
PLATFORM_ADMIN_EMAILS=admin@example.com

# Amazon RDS for MySQL
MYSQL_USER=chiefvoice
MYSQL_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
MYSQL_DATABASE=chiefvoice
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# MySQL pool — one pool is shared by all DB repositories in this process.
# Size this against the total connection budget across every app/scheduler instance.
MYSQL_POOL_MAX=10
MYSQL_POOL_MIN=0
MYSQL_POOL_IDLE_TIMEOUT_MS=10000
MYSQL_POOL_CONNECTION_TIMEOUT_MS=0
MYSQL_POOL_QUEUE_LIMIT=50
MYSQL_POOL_MAX_LIFETIME_SECONDS=0
MYSQL_APPLICATION_NAME=chiefvoice-crm-backend
MYSQL_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
MYSQL_PORT=3306
# MYSQL_URL=mysql://chiefvoice:URL_ENCODED_PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:3306/chiefvoice

# Redis (Docker) - cache/token state
REDIS_URL=redis://redis:6379

# Queue connector
# SQS support is implemented but intentionally disabled in production for now.
# Use the in-process connector until SQS is provisioned. Switch later to:
# QUEUE_PROVIDER=aws_sqs
QUEUE_PROVIDER=memory
# Future AWS SQS settings (leave empty until enabled):
AWS_REGION=ap-south-1
AWS_SQS_QUEUE_URL=
AWS_SQS_QUEUE_MAP=
AWS_SQS_WAIT_TIME_SECONDS=20
AWS_SQS_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_MS=5000
QUEUE_RETRY_MAX_MS=300000


# ChromaDB (Docker)
CHROMA_URL=http://chroma-db:8000

# AWS S3
STORAGE_PROVIDER=s3
STORAGE_REGION=ap-south-1
# Prefer the EC2 IAM role / default AWS credential chain.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=chiefvoice-recordings-production
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=
STORAGE_USE_SIGNED_URLS=true
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Google / Vertex AI runtime identity

GOOGLE_CLOUD_LOCATION=us-central1

# AI / telephony
# Organization-specific call-provider credentials are entered in the platform
# admin organization-creation form and stored in the database.
VOICE_ENGINE=pipeline
GEMINI_API_KEY=
VOBIZ_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email / integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=

# Application security / admin
MAGIC_TOKEN_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# 32-byte key (64 hex chars or base64) used to encrypt per-organization
# Google Cloud service-account credentials stored in organization_cloud_projects.
GCP_PROJECT_CREDENTIALS_ENCRYPTION_KEY=

# Event connector
# AWS EventBridge support is implemented but intentionally disabled for now.
# The connector can be enabled later without changing business logic.
AWS_EVENTBRIDGE_BUS_NAME=default
AWS_EVENTBRIDGE_SOURCE=chiefvoice.crm

# Local scheduler for now. Switch to EventBridge Scheduler later:
SCHEDULER_PROVIDER=local
SCHEDULER_TRIGGER_SECRET=replace-with-a-long-random-secret
LOCAL_AUTH_SECRET=replace-with-a-long-random-secret

# Webhook/service security
INTERNAL_API_SECRET=replace-with-a-long-random-secret
SSE_TICKET_SECRET=replace-with-a-long-random-secret
VOBIZ_WEBHOOK_SECRET=replace-with-a-long-random-secret
META_APP_SECRET=replace-with-meta-app-secret
STORAGE_USE_SIGNED_URLS=true

WS_TICKET_SECRET=replace-with-a-long-random-secret
MAX_BROWSER_VOICE_SESSIONS_PER_ORG=5

VOBIZ_STREAM_SECRET=replace-with-a-long-random-secret

# Encryption key for organization-owned call/messaging provider credentials.
# Generate with: openssl rand -hex 32
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

